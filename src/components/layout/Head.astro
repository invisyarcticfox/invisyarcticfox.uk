---
import { ClientRouter } from 'astro:transitions'
import { Font } from 'astro:assets'

const site = {
  user: 'InvisyArcticFox',
  desc: 'An arctic fox that does Blender animations and aviation photography.',
  img: { url:'https://cdn.itaf.uk/img/banner.png', alt:'Invisy ArcticFox looking at the viewer, smirking with slightly glowing eyes against a dark purple background.' }
}

interface Props { title:string }
const { title } = Astro.props
---

<head>
	<ClientRouter />
	<Font cssVariable='--font-roboto' />
	<Font cssVariable='--font-roboto-mono' />

	<meta charset='utf-8' />
	<link rel='icon' type='image/svg+xml' href='/favicon.svg' />
	<link rel='shortcut icon' href='/favicon.ico' />
	<link rel='icon' type='image/png' href='/favicons/favicon-96x96.png' sizes='96x96' />
	<link rel='apple-touch-icon' sizes='180x180' href='/favicons/apple-touch-icon.png' />
	<meta name='apple-mobile-web-app-title' content={site.user} />
	<link rel='manifest' href='/site.webmanifest' />

	<meta name='viewport' content='width=device-width, initial-scale=1.0' />
	<meta name='generator' content={Astro.generator} />
	<title>{title}</title>
	<link rel='stylesheet' href='/master.css'>
	<link rel='canonical' href={Astro.url}>
	<link rel='alternate' href={`https://invisyarcticfox.uk` + Astro.url.pathname}>
	<link rel='sitemap' href='/sitemap-index.xml'>

	<meta name='title' content={title}>
	<meta name='description' content={site.desc}>
	<meta name='keywords' content='invisyarcticfox, invisy arcticfox, invisy arctic fox'>
	<meta name='image' content={site.img.url}>
	<meta name='author' content={site.user}>
	<meta name='theme-color' content='#a6e3a1'>
	<meta name='robots' content='index, follow'>
	<meta http-equiv='Content-Type' content='text/html; charset=utf-8'>
	<meta name='language' content='English'>
	<meta name='revisit-after' content='30 days'>
	
	<meta property='og:type' content='website' />
	<meta property='og:title' content={title} />
	<meta property='og:description' content={site.desc} />
	<meta property='og:url' content={Astro.url} />
	<meta property='og:image' content={site.img.url} />
	<meta property='og:image:alt' content={site.img.alt} />
	<meta property='og:image:width' content='1280' />
	<meta property='og:image:height' content='720' />
	
	<meta name='twitter:card' content='summary_large_image' />
	<meta name='twitter:site' content={`@${site.user}`} />
	<meta name='twitter:creator' content={`@${site.user}`} />
	<meta name='twitter:title' content={title} />
	<meta name='twitter:description' content={site.desc} />
	<meta name='twitter:image' content={site.img.url} />
	<meta name='twitter:image:alt' content={site.img.alt} />
</head>