---
import Head from '~/components/layout/Head.astro'
import Footer from '~/components/layout/Footer.astro'

import '~/styles/_layout.scss'

interface Props { title:string|[string,string], isIndex?:boolean }
const { title, isIndex = false } = Astro.props

function formatTitle(title:string|[string,string], isIndex:boolean=false):string {
	if (isIndex) return 'ItAF | InvisyArcticFox'
	if (typeof title === 'string') return `${title} - ItAF`
	else return `${title[0]}: ${title[1]} - ItAF`
}
const htmlTitle = formatTitle(title, isIndex)
---

<!DOCTYPE html>
<html lang='en'>
	<Head title={htmlTitle} />
	<body>
		<header class={isIndex ? 'index' : ''} transition:name='header'>
			<h1>{ typeof title === 'string' ? !isIndex && title : title[0] }</h1>
			{ typeof title !== 'string' ? ( <div class='sub'>{title[1]}</div> ) : '' }
		</header>
		<main> <slot /> </main>
		<Footer {isIndex} />
	</body>
</html>